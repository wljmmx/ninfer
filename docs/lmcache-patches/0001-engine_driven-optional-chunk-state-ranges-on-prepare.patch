             prefetched_keys: list[ObjectKey] = []
@@ -426,6 +430,14 @@ class InlineTransferStrategy(TransferStrategy):
                         prefetched_keys, l1_owners=owners
                     )
 
+        if state_slice is not None and len(group_chunks) > 1 and group_chunks[1]:
+            _sb, _se = state_slice
+            _t = group_chunks[1][0]
+            _n = _t.numel()
+            _b = 0 if _sb < 0 else min(_sb, _n)
+            _e = _n if _se < 0 else min(_se, _n)
+            group_chunks[1][0] = _t.reshape(-1)[_b:_e].clone()
+        _rt_t1 = _rt_time.perf_counter()
         if multi_group:
             firsts = list(group_first_chunk) or [0] * len(group_keys)
             data = encode_grouped_tensors(
@@ -436,6 +448,12 @@ class InlineTransferStrategy(TransferStrategy):
             )
         else:
             data = encode_tensors(group_chunks[0])
+        _rt_t2 = _rt_time.perf_counter()
+        logger.info(
+            'retrieve timing: read %.3f s, encode %.3f s, total %.3f s, groups=%d bytes=%d',
+            _rt_t1 - _rt_t0, _rt_t2 - _rt_t1, _rt_t2 - _rt_t0,
+            len(group_keys), len(data),
+        )
         return PrepareRetrieveResponse(success=True, data=data, context={})
 
     def commit_retrieve(
