From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ninfer-local <ninfer-local@localhost>
Date: Sat, 21 Nov 2026 23:16:52 +0800
Subject: [PATCH] engine_driven: optional chunk/state ranges on
 prepare_retrieve

The client now splits one restore across connections because the payload is 181 MB and the
link carries far more when asked in parallel. A range defaults to -1, which means no
restriction, so an unmodified caller receives exactly the old bytes.

  * engine_driven_transfer: slice the KV group by chunk range before the strategy reads
    anything, and shift group_first_chunk so the encoded indices stay absolute;
  * server_transfer: the inline strategy slices the state tensor by byte range after it is
    cloned, and logs read/encode/total time so the split can be priced;
  * transport/base: the rpc signature the zmq server dispatches on.

Local patch for this deployment, not intended for upstream as-is.
---
 .../modules/engine_driven_transfer.py         | 21 +++++++++++++++++++
 .../multiprocess/modules/server_transfer.py   | 18 ++++++++++++++++
 lmcache/v1/multiprocess/transport/base.py     |  8 ++++++-
 3 files changed, 46 insertions(+), 1 deletion(-)

diff --git a/lmcache/v1/multiprocess/modules/engine_driven_transfer.py b/lmcache/v1/multiprocess/modules/engine_driven_transfer.py
index ba6890c..d941460 100644
--- a/lmcache/v1/multiprocess/modules/engine_driven_transfer.py
+++ b/lmcache/v1/multiprocess/modules/engine_driven_transfer.py
@@ -599,6 +599,10 @@ class EngineDrivenTransferModule(DiscoverableModule, InstanceLivenessTarget):
         self,
         key: IPCCacheServerKey,
         instance_id: int,
+        chunk_begin: int = -1,
+        chunk_end: int = -1,
+        state_begin: int = -1,
+        state_end: int = -1,
     ) -> PrepareRetrieveResponse:
         """Retrieve prefetched chunks and return serialized CPU tensors.
 
@@ -627,12 +631,29 @@ class EngineDrivenTransferModule(DiscoverableModule, InstanceLivenessTarget):
                 group_first_chunk.append(first)
                 narrowed.append(g_keys[first:])
             group_keys = narrowed
+        # Slice the KV group and pass the state range through. A caller that wants the whole thing
+        # sends -1 and gets exactly what it used to get.
+        state_slice = None
+        if state_begin >= 0 or state_end >= 0:
+            state_slice = (state_begin, state_end)
+        if group_keys is not None and len(group_keys) > 0 and (chunk_begin >= 0 or chunk_end >= 0):
+            kv_keys = group_keys[0]
+            begin = 0 if chunk_begin < 0 else min(chunk_begin, len(kv_keys))
+            end = len(kv_keys) if chunk_end < 0 else min(chunk_end, len(kv_keys))
+            if end < begin:
+                end = begin
+            group_keys[0] = kv_keys[begin:end]
+            if group_first_chunk:
+                group_first_chunk[0] = group_first_chunk[0] + begin
+            else:
+                group_first_chunk = [begin] + [0] * (len(group_keys) - 1)
         response = strategy.prepare_retrieve(
             key=key,
             instance_id=instance_id,
             resolve_obj_keys=self._resolve_single_group_obj_keys,
             group_keys=group_keys,
             group_first_chunk=group_first_chunk,
+            state_slice=state_slice,
         )
         session = self._ctx.session_manager.get_or_create(key.request_id)
         session.extras["retrieve_start_time"] = time.perf_counter()
